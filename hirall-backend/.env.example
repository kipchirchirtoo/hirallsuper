# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
ENVIRONMENT=development

# Database Configuration
# Local Docker: postgres://postgres:postgrespassword@localhost:5432/giftmart
# Neon Cloud MVP: postgresql://[user]:[password]@[endpoint].neon.tech/giftmart?sslmode=require
# AWS RDS: postgresql://[user]:[password]@[rds-endpoint].rds.amazonaws.com:5432/giftmart
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/giftmart
DATABASE_MAX_CONNECTIONS=20

# Redis Cache & Queue
REDIS_URL=redis://127.0.0.1:6379

# JWT Authentication
JWT_SECRET=hirall_super_secret_jwt_signing_key_change_in_production_2026
JWT_REFRESH_SECRET=hirall_refresh_secret_signing_key_change_in_production_2026
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=30

# Object Storage: Cloudflare R2 (Prod) / MinIO (Local Dev)
# For Cloudflare R2:
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=giftmart-media
# S3_ACCESS_KEY_ID=<cloudflare_r2_access_key>
# S3_SECRET_ACCESS_KEY=<cloudflare_r2_secret_key>
# S3_PUBLIC_DOMAIN=https://media.giftmart.co.ke
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=giftmart-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadminpassword
S3_PUBLIC_DOMAIN=http://localhost:9000/giftmart-media
